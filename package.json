{
  "name": "lg-shabbat-fridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turns an LG WiFi fridge's Sabbath mode on every Shabbos and Yom Tov, run for free on a GitHub Actions schedule.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tick": "node scripts/tick.js",
    "preview": "node scripts/preview.js",
    "control": "node scripts/controller.js",
    "manual:on": "node scripts/manual.js on",
    "manual:off": "node scripts/manual.js off",
    "setup:official": "node scripts/setup-official.js",
    "setup:v2": "node scripts/setup-v2.js"
  }
}
